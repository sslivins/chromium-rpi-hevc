Description: 0018-h265-bitsize-payload-only (narrowed to broken kernel)
 rpi-hevc-dec (Pi-specific HEVC stateless V4L2 driver) checks
 data_byte_offset + (bit_size in bytes) <= bytesused for each slice.
 Chromium's pre-existing patch 0005 sets
   sp.bit_size = end_off_in_frame * 8
 i.e. the END-of-slice bit offset in the OUTPUT buffer. That is the
 long-standing downstream "total" convention and is what every
 published rpi-hevc-dec expects -- 6.12.y, and 6.18.y at or above
 rpi-linux commit 7a41407d ("media/hevc_d: Fix old-style bit_size
 handling support", 2026-05-14) which restores old_bits=true gating
 for NV12_COL128.
 .
 EXACTLY ONE published rpt-rpi-2712 deb regressed against that:
 linux-image-6.18.29+rpt-rpi-2712. On that build the old_bits=true
 arm of the kernel switch was inadvertently dropped, so the driver
 demands payload-only bit_size = (end - data) * 8 and rejects the
 "total" formula with
   data_byte_offset N + bits B (= X bytes) > bytesused Y
 (where X == bytesused), skipping the decode and leaving the capture
 surface all zero -- the well-known Pi5 6.18 "green frame" symptom.
 .
 Both 6.12 and 6.18 negotiate the SAME CAPTURE fourcc (NV12_COL128 =
 "NC12") so fourcc cannot discriminate. Probe VIDIOC_QUERYCAP once
 and special-case exactly that one broken kernel:
   cap.version == KERNEL_VERSION(6,18,29) -> payload-only (= (end-data)*8)
   anything else                          -> total        (= end_off*8)
 .
 This is a narrow transient workaround. Once a new linux-image-*-
 rpt-rpi-2712 deb (presumably including 7a41407d) ships, the
 workaround branch will stop matching, the default "total" formula
 will be sent, and the post-fix kernel will accept it -- after which
 this patch can be removed.
 .
 Validated on Pi5 / 6.18.29 (Pi100) and Pi5 / 6.12.75 (Pi114): both
 play 1080p HEVC cleanly with the SAME chromium binary; chromium picks
 the right formula at runtime.
Forwarded: not-needed
Author: Steve Slivinski <stesli@github.local>
Last-Update: 2026-05-23
Index: chromium-147.0.7727.116/media/gpu/v4l2/v4l2_video_decoder_delegate_h265.h
===================================================================
--- chromium-147.0.7727.116.orig/media/gpu/v4l2/v4l2_video_decoder_delegate_h265.h
+++ chromium-147.0.7727.116/media/gpu/v4l2/v4l2_video_decoder_delegate_h265.h
@@ -102,6 +102,11 @@ class V4L2VideoDecoderDelegateH265 : pub
   std::vector<int32_t> dpb_poc_map_;
   // Whether we've explicitly set the START_CODE control for this device yet.
   bool start_code_control_set_ = false;
+  // PATCH_0018: cache of negotiated CAPTURE-queue pixelformat semantics.
+  // True iff the kernel negotiated V4L2_PIX_FMT_NV12MT_COL128 or _10_COL128,
+  // in which case rpi-hevc-dec uses the non-old_bits bit_size convention.
+  bool capture_format_probed_ = false;
+  bool capture_uses_nv12mt_ = false;
 };
 
 }  // namespace media
Index: chromium-147.0.7727.116/media/gpu/v4l2/v4l2_video_decoder_delegate_h265.cc
===================================================================
--- chromium-147.0.7727.116.orig/media/gpu/v4l2/v4l2_video_decoder_delegate_h265.cc
+++ chromium-147.0.7727.116/media/gpu/v4l2/v4l2_video_decoder_delegate_h265.cc
@@ -628,6 +628,48 @@ H265Decoder::H265Accelerator::Status V4L
       slice_off_in_frame + 3 + header_bytes_in_buffer;
   const size_t end_off_in_frame = slice_off_in_frame + slice_bytes;
 
+  // PATCH_0018_HEVC_BITSIZE_BROKEN_KERNEL_WORKAROUND: rpi-hevc-dec on
+  // Pi5 lost its downstream old_bits=true gating for NV12_COL128 in
+  // exactly one published kernel: linux-image-6.18.29+rpt-rpi-2712.
+  // Upstream rpi-linux commit 7a41407d ("media/hevc_d: Fix old-style
+  // bit_size handling support") restores the gating; until that ships
+  // in a deb we send payload-only on the broken kernel only.
+  if (!capture_format_probed_) {
+    capture_format_probed_ = true;
+    constexpr __u32 kBitSizePayloadOnlyMinVersion =
+        (6u << 16) | (18u << 8) | 29u;  // KERNEL_VERSION(6,18,29)
+    struct v4l2_capability cap;
+    memset(&cap, 0, sizeof(cap));
+    if (device_->Ioctl(VIDIOC_QUERYCAP, &cap) == 0) {
+      const __u32 ver = cap.version;
+      capture_uses_nv12mt_ = (ver == kBitSizePayloadOnlyMinVersion);
+      VLOG(1) << "[HEVC_DBG] driver=" << reinterpret_cast<const char*>(cap.driver)
+              << " version=0x" << std::hex << ver << std::dec
+              << " (" << ((ver >> 16) & 0xff) << "."
+              << ((ver >> 8) & 0xff) << "." << (ver & 0xff) << ")"
+              << " payload_only=" << capture_uses_nv12mt_
+              << " (selects "
+              << (capture_uses_nv12mt_ ? "payload-only" : "total")
+              << " bit_size semantics)";
+    } else {
+      VPLOGF(1) << "VIDIOC_QUERYCAP failed; assuming total (default) "
+                << "bit_size semantics";
+    }
+  }
+  // PATCH_0019: empirically on rpt-rpi-2712 6.18.29 the kernel always
+  // interprets bit_size as payload-only bits (= bytes_after_data_off * 8).
+  // Sending end_off*8 (the prior "old_bits=true" assumption) over-reports
+  // by data_off*8 and trips data_byte_offset+bytes>bytesused. Use the
+  // payload-only formula for both fourccs.
+  // PATCH_0020: select bit_size formula based on the negotiated CAPTURE
+  // pixfmt cached above. SAND128/NV12MT (Pi5 6.18.y rpi-hevc-dec) wants
+  // payload-only bits = (end - data) * 8. Legacy NV12 (Pi5 6.12.y rpivid
+  // path) wants total bits to end-of-slice = end_off * 8.
+  const __u32 bit_size_value =
+      capture_uses_nv12mt_
+          ? static_cast<__u32>((end_off_in_frame - data_off_in_frame) * 8)
+          : static_cast<__u32>(end_off_in_frame * 8);
+
   struct v4l2_ctrl_hevc_slice_params sp;
   memset(&sp, 0, sizeof(sp));
   // Per rpi-hevc-dec (drivers/media/platform/raspberrypi/hevc_dec/
@@ -636,7 +678,7 @@ H265Decoder::H265Accelerator::Status V4L
   // bit_size measures the slice DATA length (from data_byte_offset
   // to end of slice payload), in bits. Driver tolerates including
   // rbsp_stop_one_bit byte.
-  sp.bit_size = static_cast<__u32>(end_off_in_frame * 8);  // PATCH_BITSIZE_FIX
+  sp.bit_size = bit_size_value;  // PATCH_BITSIZE_FIX + PATCH_0018
   sp.data_byte_offset = static_cast<__u32>(data_off_in_frame);
   sp.num_entry_point_offsets = 0;  // tiles/wpp not implemented yet
   sp.nal_unit_type = static_cast<__u8>(slice_hdr->nal_unit_type);
