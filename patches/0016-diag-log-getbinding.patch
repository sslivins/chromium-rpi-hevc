Description: AGORA: Diagnostic LOG() in OzoneImageGLTexturesHolder GetBinding/CreateAndStoreTexture
 Adds AGORA_GETBINDING/AGORA_CREATEANDSTORE warning logs that print the
 format flags, plane count, buffer_plane_index, and chosen GL target for
 every NativePixmap import. Used to diagnose the Pi5 SAND128 green-frame
 bug (issue sslivins/chromium-rpi-hevc#41) by determining at runtime which
 branch of GetBinding the V4L2 HEVC output is actually taking.
Author: Agora <build@agora>
Forwarded: not-needed

--- a/gpu/command_buffer/service/shared_image/ozone_image_gl_textures_holder.cc
+++ b/gpu/command_buffer/service/shared_image/ozone_image_gl_textures_holder.cc
@@ -5,6 +5,7 @@
 #include "gpu/command_buffer/service/shared_image/ozone_image_gl_textures_holder.h"
 
 #include <memory>
+#include <string>
 
 #include "base/check.h"
 #include "base/memory/scoped_refptr.h"
@@ -53,6 +54,16 @@ std::unique_ptr<ui::NativePixmapGLBinding> GetBinding(
     const gfx::ColorSpace& color_space,
     GLuint& gl_texture_service_id,
     GLenum& target) {
+  // AGORA_DIAG: log the inputs so we can determine which branch of the
+  // multi-plane vs external-sampler decision is taken for Pi5 SAND128 frames.
+  LOG(WARNING) << "AGORA_GETBINDING"
+               << " plane_index=" << plane_index
+               << " size=" << size.width() << "x" << size.height()
+               << " is_single_plane=" << format.is_single_plane()
+               << " is_multi_plane=" << format.is_multi_plane()
+               << " PrefersExternalSampler=" << format.PrefersExternalSampler()
+               << " NumberOfPlanes=" << format.NumberOfPlanes()
+               << " format=" << format.ToString();
   ui::GLOzone* gl_ozone = ui::OzonePlatform::GetInstance()
                               ->GetSurfaceFactoryOzone()
                               ->GetCurrentGLOzone();
@@ -87,6 +98,15 @@ std::unique_ptr<ui::NativePixmapGLBinding> GetBinding(
   } else {
     target = GL_TEXTURE_2D;
   }
+  // AGORA_DIAG: print the post-decision state so we know whether this frame
+  // took the per-plane (buffer_plane_index=0/1, GL_TEXTURE_2D) path that mpv
+  // uses successfully, or the multi-plane EGLImage (nullopt, EXTERNAL_OES)
+  // path that renders solid green on Mesa v3d.
+  LOG(WARNING) << "AGORA_GETBINDING_RESULT"
+               << " buffer_plane_index="
+               << (buffer_plane_index.has_value() ? std::to_string(*buffer_plane_index) : std::string("nullopt"))
+               << " plane_size=" << plane_size.width() << "x" << plane_size.height()
+               << " target=" << (target == GL_TEXTURE_EXTERNAL_OES ? "EXTERNAL_OES" : "2D");
 
   gl::GLApi* api = gl::g_current_gl_context;
   DCHECK(api);
@@ -172,6 +192,12 @@ bool OzoneImageGLTexturesHolder::CreateAndStoreTexture(
   DCHECK(backing && pixmap);
   auto format = backing->format();
   auto size = backing->size();
+  // AGORA_DIAG: log entry into the plane-iteration loop.
+  LOG(WARNING) << "AGORA_CREATEANDSTORE"
+               << " format=" << format.ToString()
+               << " is_multi_plane=" << format.is_multi_plane()
+               << " NumberOfPlanes=" << format.NumberOfPlanes()
+               << " size=" << size.width() << "x" << size.height();
   // Initialize the holder with N textures using format and plane.
   for (int plane_index = 0; plane_index < format.NumberOfPlanes();
        plane_index++) {
