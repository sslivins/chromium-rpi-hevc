Description: Remap P010 -> P030 for BROADCOM SAND128 on both import paths
 Mesa v3d (Raspberry Pi 5) only supports the BROADCOM SAND128 column-tiled
 modifier with DRM_FORMAT_P030 (10-bit packed, 3 samples per 32-bit word),
 not DRM_FORMAT_P010 (10-bit padded to 16). Chromium's pipeline only knows
 viz::MultiPlaneFormat::kP010, which always maps to DRM_FORMAT_P010.
 .
 The data layout is already what Mesa expects for P030; only the fourcc tag
 needs to change, and it has to change on BOTH import paths or the two
 disagree about the same buffer:
 .
 1. ui/gfx/linux/gbm_wrapper.cc: override the DRM format at the
    gbm_bo_import call when a BROADCOM-vendor modifier is seen on a P010
    buffer.
 2. ui/ozone/common/native_pixmap_egl_binding.cc: same remap for the
    EGL_LINUX_DRM_FOURCC_EXT attribute on the EGL_LINUX_DMA_BUF_EXT path,
    so the EGLImage matches what the underlying bo was imported as.
 .
 Folded from the original 0011-gbm-p030-import and 0012-egl-p030-binding,
 which documented themselves as a pair.
Author: Steve Slivinski <sslivins@github.com>
Forwarded: not-needed

--- a/ui/gfx/linux/gbm_wrapper.cc
+++ b/ui/gfx/linux/gbm_wrapper.cc
@@ -7,6 +7,7 @@
 #include <gbm.h>
 #include <sys/mman.h>
 
+#include <drm_fourcc.h>
 #include <memory>
 #include <utility>
 #include <vector>
@@ -458,6 +459,21 @@ class Device final : public ui::GbmDevice {
       UNSAFE_TODO(fd_data.offsets[i]) = handle.planes[i].offset;
     }
 
+    // PATCH_GBM_IMPORT_NC30: Mesa v3d (Pi 5) only accepts the BROADCOM
+    // SAND128 column-tiled modifier with DRM_FORMAT_P030 (10-bit packed:
+    // 3 samples per 32-bit word), not DRM_FORMAT_P010 (10-bit padded to
+    // 16). Chromium only knows kP010, so remap the fourcc tag here.
+#ifndef DRM_FORMAT_P030
+#define DRM_FORMAT_P030 fourcc_code('P', '0', '3', '0')
+#endif
+    constexpr uint64_t kBroadcomVendorShift = 56;
+    if (fd_data.format == DRM_FORMAT_P010 &&
+        (handle.modifier >> kBroadcomVendorShift) == 7 /* BROADCOM */) {
+      LOG(WARNING) << "PATCH_GBM_IMPORT_NC30: remapping P010 -> P030 for "
+                      "BROADCOM SAND128 modifier";
+      fd_data.format = DRM_FORMAT_P030;
+    }
+
     // PATCH_GBM_IMPORT_FIX diag: log handle/modifier/strides before import.
     {
       std::string sstr, ostr, fstr;

--- a/ui/ozone/common/native_pixmap_egl_binding.cc
+++ b/ui/ozone/common/native_pixmap_egl_binding.cc
@@ -27,6 +27,8 @@ namespace {
 #define DRM_FORMAT_R16 FOURCC('R', '1', '6', ' ')
 #define DRM_FORMAT_GR88 FOURCC('G', 'R', '8', '8')
 #define DRM_FORMAT_GR1616 FOURCC('G', 'R', '3', '2')
+#define DRM_FORMAT_P010 FOURCC('P', '0', '1', '0')
+#define DRM_FORMAT_P030 FOURCC('P', '0', '3', '0')
 #define DRM_FORMAT_RGB565 FOURCC('R', 'G', '1', '6')
 #define DRM_FORMAT_ARGB8888 FOURCC('A', 'R', '2', '4')
 #define DRM_FORMAT_ABGR8888 FOURCC('A', 'B', '2', '4')
@@ -108,7 +110,18 @@ bool NativePixmapEGLBinding::InitializeFromNativePixmap(
   attrs.push_back(EGL_HEIGHT);
   attrs.push_back(size_.height());
   attrs.push_back(EGL_LINUX_DRM_FOURCC_EXT);
-  attrs.push_back(GetFourCCFormatFromSharedImageFormat(format_));
+  {
+    uint32_t fcc = GetFourCCFormatFromSharedImageFormat(format_);
+    // PATCH_EGL_NC30: Mesa v3d on Pi 5 only accepts BROADCOM SAND128 with
+    // DRM_FORMAT_P030 (10-bit packed). Remap P010 -> P030 here so EGL
+    // matches the gbm_bo we imported with the same remap.
+    uint64_t mod = pixmap->GetFormatModifier();
+    if (fcc == DRM_FORMAT_P010 && (mod >> 56) == 7 /* BROADCOM */) {
+      LOG(WARNING) << "PATCH_EGL_NC30: remapping P010 -> P030 for BROADCOM modifier";
+      fcc = DRM_FORMAT_P030;
+    }
+    attrs.push_back(fcc);
+  }
 
   if (format_ == viz::MultiPlaneFormat::kNV12 ||
       format_ == viz::MultiPlaneFormat::kYV12 ||
