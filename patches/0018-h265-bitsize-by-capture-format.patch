Description: h265: pick rpi-hevc-dec bit_size semantics from the CAPTURE format
 rpi-hevc-dec (Pi 5 stateless HEVC) checks, per slice,
   data_byte_offset + DIV_ROUND_UP(bits, 8) <= bytesused
 where "bits" is derived from v4l2_ctrl_hevc_slice_params.bit_size. What
 bit_size means depends on the negotiated CAPTURE pixelformat:
 .
  - NV12MT_COL128 'Nc12' / NV12MT_10_COL128 'Nc30' (multi-planar SAND,
    the upstream format): always payload-only, i.e.
    bit_size = (end_of_slice - data_byte_offset) * 8.
  - NV12_COL128 'NC12' / NV12_10_COL128 'NC30' (legacy single-planar SAND):
    the driver's old_bits path, bit_size = end_of_slice_offset * 8
    ("total"). Some kernels lost old_bits (rpt 6.18.29, Ubuntu linux-raspi
    7.0.0-10xx), making 'NC12' payload-only there and turning every slice
    into a rejected decode (green frames, issue #81).
 .
 Every kernel with that regression also offers the multi-planar formats,
 and patch 0024 makes chromium prefer them. So: query the CAPTURE format
 with VIDIOC_G_FMT and send payload-only for 'Nc12'/'Nc30', "total"
 otherwise. The legacy formats are then only used on kernels without
 multi-planar SAND (e.g. rpi 6.12.y), where "total" is correct. This is the
 same rule Raspberry Pi's FFmpeg uses (bit_size_is_offset keyed on the
 negotiated format) and replaces the previous exact kernel-version match.
Forwarded: not-needed
Author: Steve Slivinski <stesli@github.local>
Last-Update: 2026-10-10
--- a/media/gpu/v4l2/v4l2_video_decoder_delegate_h265.cc
+++ b/media/gpu/v4l2/v4l2_video_decoder_delegate_h265.cc
@@ -16,6 +16,7 @@
 #include "base/logging.h"
 #include "base/memory/scoped_refptr.h"
 #include "build/build_config.h"
+#include "media/base/video_types.h"
 #include "media/gpu/macros.h"
 #include "media/gpu/v4l2/v4l2_decode_surface.h"
 #include "media/gpu/v4l2/v4l2_decode_surface_handler.h"
@@ -638,6 +639,45 @@ H265Decoder::H265Accelerator::Status V4L2VideoDecoderDelegateH265::SubmitSlice(
       slice_off_in_frame + 3 + header_bytes_in_buffer;
   const size_t end_off_in_frame = slice_off_in_frame + slice_bytes;
 
+  // PATCH_0018_HEVC_BITSIZE_BY_CAPTURE_FORMAT: rpi-hevc-dec's bit_size
+  // convention is tied to the negotiated CAPTURE format, not the kernel:
+  //  - multi-planar SAND (NV12MT_COL128 'Nc12' / NV12MT_10_COL128 'Nc30')
+  //    always means payload-only: bit_size = (end - data_byte_offset) * 8.
+  //  - legacy single-planar SAND (NV12_COL128 'NC12' / 'NC30') historically
+  //    means "total" (end-of-slice offset * 8, the old_bits path), but some
+  //    kernels (rpt 6.18.29, Ubuntu linux-raspi 7.0) dropped old_bits.
+  // Patch 0024 makes chromium prefer the multi-planar formats whenever the
+  // driver offers them (every kernel that has the old_bits regression does),
+  // so the legacy formats, and "total", are only used on kernels that don't
+  // offer multi-planar SAND at all (e.g. rpi 6.12.y). This mirrors
+  // Raspberry Pi's FFmpeg, which keys bit_size_is_offset on the format.
+  // Query G_FMT per slice: it is cheap and tracks format changes on
+  // resolution / bit-depth changes.
+  {
+    struct v4l2_format capture_fmt;
+    memset(&capture_fmt, 0, sizeof(capture_fmt));
+    capture_fmt.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    bool payload_only = false;
+    if (device_->Ioctl(VIDIOC_G_FMT, &capture_fmt) == 0) {
+      const __u32 pixfmt = capture_fmt.fmt.pix_mp.pixelformat;
+      payload_only = pixfmt == v4l2_fourcc('N', 'c', '1', '2') ||
+                     pixfmt == v4l2_fourcc('N', 'c', '3', '0');
+      if (pixfmt != last_capture_pixfmt_) {
+        last_capture_pixfmt_ = pixfmt;
+        VLOG(1) << "[HEVC_DBG] CAPTURE pixfmt=" << FourccToString(pixfmt)
+                << " -> " << (payload_only ? "payload-only" : "total")
+                << " bit_size semantics";
+      }
+    } else {
+      VPLOGF(1) << "VIDIOC_G_FMT(CAPTURE) failed; assuming total bit_size";
+    }
+    bit_size_payload_only_ = payload_only;
+  }
+  const __u32 bit_size_value =
+      bit_size_payload_only_
+          ? static_cast<__u32>((end_off_in_frame - data_off_in_frame) * 8)
+          : static_cast<__u32>(end_off_in_frame * 8);
+
   struct v4l2_ctrl_hevc_slice_params sp;
   memset(&sp, 0, sizeof(sp));
   // Per rpi-hevc-dec (drivers/media/platform/raspberrypi/hevc_dec/
@@ -646,7 +686,7 @@ H265Decoder::H265Accelerator::Status V4L2VideoDecoderDelegateH265::SubmitSlice(
   // bit_size measures the slice DATA length (from data_byte_offset
   // to end of slice payload), in bits. Driver tolerates including
   // rbsp_stop_one_bit byte.
-  sp.bit_size = static_cast<__u32>(end_off_in_frame * 8);  // PATCH_BITSIZE_FIX
+  sp.bit_size = bit_size_value;  // PATCH_BITSIZE_FIX + PATCH_0018
   sp.data_byte_offset = static_cast<__u32>(data_off_in_frame);
   sp.num_entry_point_offsets = 0;  // tiles/wpp not implemented yet
   sp.nal_unit_type = static_cast<__u8>(slice_hdr->nal_unit_type);
--- a/media/gpu/v4l2/v4l2_video_decoder_delegate_h265.h
+++ b/media/gpu/v4l2/v4l2_video_decoder_delegate_h265.h
@@ -102,6 +102,10 @@ class V4L2VideoDecoderDelegateH265 : public H265Decoder::H265Accelerator {
   std::vector<int32_t> dpb_poc_map_;
   // Whether we've explicitly set the START_CODE control for this device yet.
   bool start_code_control_set_ = false;
+  // PATCH_0018: bit_size semantics derived from the negotiated CAPTURE
+  // pixelformat (see SubmitSlice()).
+  bool bit_size_payload_only_ = false;
+  uint32_t last_capture_pixfmt_ = 0;
 };
 
 }  // namespace media
