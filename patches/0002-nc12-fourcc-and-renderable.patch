--- a/media/mojo/services/gpu_mojo_media_client_linux.cc
+++ b/media/mojo/services/gpu_mojo_media_client_linux.cc
@@ -49,6 +49,15 @@ std::vector<Fourcc> GetPreferredRenderableFourccs(
     const gpu::GpuPreferences& gpu_preferences,
     const gpu::GpuFeatureInfo& gpu_feature_info) {
   std::vector<Fourcc> renderable_fourccs;
+#if BUILDFLAG(USE_V4L2_CODEC_RPI)
+  // EXPERIMENTAL: Pi 5 BCM2712 column-tiled NV12 (NC12) from rpi-hevc-dec
+  // /dev/video19. Inserted first so PickRenderableFourcc()/
+  // PickDecoderOutputFormat() prefer it over the trailing AR24/BGR4
