     switch (pix_fmt) {
+#if BUILDFLAG(USE_V4L2_CODEC_RPI)
+#ifndef V4L2_PIX_FMT_NC12
+#define V4L2_PIX_FMT_NC12 v4l2_fourcc('N', 'C', '1', '2')
+#endif
+      case V4L2_PIX_FMT_NC12: {
+        // NC12 is semi-planar with Broadcom SAND128 column-tile layout. The
+        // chroma plane lives at offset (height * 128) within the first
+        // column, NOT at (y_stride * height) -- y_stride here is the
+        // per-column line count reported via bytesperline, not a normal
+        // linear stride.
+        const size_t sand128_chroma_offset =
+            static_cast<size_t>(pix_mp.height) * 128u;
+        const size_t sand128_chroma_size =
+            (static_cast<size_t>(pix_mp.height) / 2u) * 128u;
+        planes.emplace_back(y_stride, sand128_chroma_offset,
+                            sand128_chroma_size);
+        DCHECK_EQ(2u, planes.size());
+        break;
+      }
+#endif
       case V4L2_PIX_FMT_NV12:
         // The stride of UV is the same as Y in NV12.
